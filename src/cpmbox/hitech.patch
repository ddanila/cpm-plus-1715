+/* Validate the flat 8.3 destination before opening anything. Reject existing
+ * names (including case-folded collisions); never truncate an unrelated file. */
+static void tar_name(char *dest, char *header, Drive drive)
+{
+  int i, stem = 0, ext = -1, c;
+  dest[0] = drive + 'A' - 1; dest[1] = ':';
+  for (i = 0; i < 100 && header[i]; ++i) {
+    if ((unsigned char)header[i] < 32 || (unsigned char)header[i] > 126) pm_fail("Unsafe tar name");
+    c = toupper(header[i]);
+    if (i >= 12) pm_fail("Tar name is not 8.3");
+    if (c == '.') {
+      if (!stem || ext >= 0) pm_fail("Tar name is not 8.3");
+      ext = 0;
+    } else {
+      if (!isalnum(c) && !strchr("!#$%&'()+-@^_`{}~", c))
+        pm_fail("Unsafe tar name");
+      if (ext < 0) { if (++stem > 8) pm_fail("Tar name is not 8.3"); }
+      else if (++ext > 3) pm_fail("Tar name is not 8.3");
+    }
+    dest[i + 2] = c;
+  }
+  if (!stem || ext == 0 || i == 100) pm_fail("Tar name is not 8.3");
+  dest[i + 2] = 0;
+  if (!strncmp(header + 257, "ustar", 5) && header[345])
+    pm_fail("Tar paths are not supported");
+}
